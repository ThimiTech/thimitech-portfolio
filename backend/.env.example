# Copy to backend/.env (start.bat / start.sh do this automatically on first run).
SECRET_KEY=dev-insecure-change-me
DEBUG=True

# PostgreSQL 15+ (Django 6.1 requirement)
DB_NAME=thimitech
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Celery broker. Without Redis, the start scripts set CELERY_TASK_ALWAYS_EAGER=True (jobs run inline).
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=True

# Email (console backend by default in dev)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Vue app origin for links in emails (password reset). Defaults: http://localhost:5173 (DEBUG) / https://thimitech.com
# FRONTEND_URL=https://thimitech.com
